<style>
  .weather-screen {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 8px 10px 6px;
    display: flex;
    flex-direction: column;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* =========================
     TOP HALF — TODAY
     ========================= */

  .today {
    height: 50%;
    box-sizing: border-box;
    display: flex;
    border-bottom: 2px solid #000;
    padding-bottom: 14px;
  }

  .today-left {
    width: 42%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .location {
    font-size: 27px;
    font-weight: 700;
  }

  .date {
    margin-top: 3px;
    font-size: 18px;
    font-weight: 600;
  }

  .today-weather-row {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .temperature {
    font-size: 72px;
    line-height: 0.9;
    font-weight: 700;
  }

  .current-weather {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .current-icon svg {
    width: 66px;
    height: 66px;
    display: block;
  }

  .current-description {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.05;
  }

  .today-right {
    width: 58%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 25px;
  }

  .high-low {
    font-size: 31px;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .today-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px 28px;
  }

  .detail-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .detail-value {
    margin-top: 2px;
    font-size: 21px;
    font-weight: 700;
  }

  /* =========================
     BOTTOM HALF — FIVE DAYS
     ========================= */

  .forecast {
    height: 50%;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding-top: 14px;
  }

  .day {
    text-align: center;
    padding: 0 8px;
    border-left: 1px solid #999;
  }

  .day:first-child {
    border-left: none;
  }

  .day-name {
    font-size: 21px;
    font-weight: 700;
  }

  .day-date {
    margin-top: 3px;
    font-size: 15px;
    font-weight: 600;
  }

  .day-icon {
    height: 52px;
    margin-top: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .day-icon svg {
    width: 46px;
    height: 46px;
    display: block;
  }

  .day-description {
    height: 24px;
    margin-top: 2px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.05;
  }

  .day-temps {
    margin-top: 3px;
    font-size: 26px;
    font-weight: 700;
  }

  .day-low {
    font-weight: 400;
  }

  .day-rain {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  .footer {
    position: absolute;
    right: 10px;
    bottom: 4px;
    font-size: 8px;
  }

  .weather-svg {
    fill: none;
    stroke: black;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>


{% assign dates = daily.time %}
{% assign codes = daily.weather_code %}
{% assign highs = daily.temperature_2m_max %}
{% assign lows = daily.temperature_2m_min %}
{% assign rain_chances = daily.precipitation_probability_max %}

{% assign today_date = dates | first %}
{% assign today_high = highs | first %}
{% assign today_low = lows | first %}
{% assign today_rain = rain_chances | first %}

{% assign code = current.weather_code %}


{% case code %}
  {% when 0 %}
    {% assign current_description = "Clear" %}
  {% when 1 %}
    {% assign current_description = "Mostly clear" %}
  {% when 2 %}
    {% assign current_description = "Partly cloudy" %}
  {% when 3 %}
    {% assign current_description = "Overcast" %}
  {% when 45, 48 %}
    {% assign current_description = "Fog" %}
  {% when 51, 53, 55 %}
    {% assign current_description = "Drizzle" %}
  {% when 56, 57 %}
    {% assign current_description = "Freezing drizzle" %}
  {% when 61, 63, 65 %}
    {% assign current_description = "Rain" %}
  {% when 66, 67 %}
    {% assign current_description = "Freezing rain" %}
  {% when 71, 73, 75, 77 %}
    {% assign current_description = "Snow" %}
  {% when 80, 81, 82 %}
    {% assign current_description = "Showers" %}
  {% when 85, 86 %}
    {% assign current_description = "Snow showers" %}
  {% when 95, 96, 99 %}
    {% assign current_description = "Thunderstorm" %}
  {% else %}
    {% assign current_description = "Unknown" %}
{% endcase %}


<div class="weather-screen">

  <!-- TODAY -->

  <div class="today">

    <div class="today-left">

      <div class="location">
        Vancouver
      </div>

      <div class="date">
        {{ today_date | l_date: "%A, %B %d" }}
      </div>

      <div class="today-weather-row">

        <div class="temperature">
          {{ current.temperature_2m | round }}°
        </div>

        <div class="current-weather">

          <div class="current-icon">

            {% case code %}

              {% when 0, 1 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <circle cx="32" cy="32" r="12"/>
                  <line x1="32" y1="5" x2="32" y2="14"/>
                  <line x1="32" y1="50" x2="32" y2="59"/>
                  <line x1="5" y1="32" x2="14" y2="32"/>
                  <line x1="50" y1="32" x2="59" y2="32"/>
                  <line x1="13" y1="13" x2="19" y2="19"/>
                  <line x1="45" y1="45" x2="51" y2="51"/>
                  <line x1="51" y1="13" x2="45" y2="19"/>
                  <line x1="19" y1="45" x2="13" y2="51"/>
                </svg>

              {% when 2 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <circle cx="24" cy="22" r="10"/>
                  <line x1="24" y1="5" x2="24" y2="10"/>
                  <line x1="8" y1="22" x2="13" y2="22"/>
                  <line x1="35" y1="11" x2="31" y2="15"/>
                  <path d="M18 47
                           C18 40 23 36 29 36
                           C31 29 37 26 43 28
                           C49 29 52 33 52 38
                           C58 39 60 43 60 47
                           C60 52 56 55 51 55
                           H24
                           C20 55 17 52 17 48
                           Z"/>
                </svg>

              {% when 3 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 45
                           C14 38 19 33 26 33
                           C28 25 35 21 42 23
                           C49 24 53 29 53 35
                           C59 36 61 40 61 45
                           C61 50 57 53 52 53
                           H22
                           C17 53 14 50 14 45
                           Z"/>
                </svg>

              {% when 45, 48 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M16 31
                           C16 25 21 21 27 21
                           C30 15 38 14 43 18
                           C48 18 52 22 52 27"/>
                  <line x1="10" y1="36" x2="54" y2="36"/>
                  <line x1="15" y1="44" x2="49" y2="44"/>
                  <line x1="20" y1="52" x2="44" y2="52"/>
                </svg>

              {% when 51, 53, 55, 56, 57 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 34
                           C14 27 19 23 26 23
                           C28 16 35 13 42 15
                           C49 16 52 21 52 27
                           C58 28 60 32 60 36
                           C60 41 56 44 51 44
                           H23
                           C18 44 14 40 14 34
                           Z"/>
                  <line x1="24" y1="50" x2="22" y2="55"/>
                  <line x1="34" y1="50" x2="32" y2="55"/>
                  <line x1="44" y1="50" x2="42" y2="55"/>
                </svg>

              {% when 61, 63, 65, 66, 67, 80, 81, 82 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 32
                           C14 25 19 21 26 21
                           C28 14 35 11 42 13
                           C49 14 52 19 52 25
                           C58 26 60 30 60 34
                           C60 39 56 42 51 42
                           H23
                           C18 42 14 38 14 32
                           Z"/>
                  <line x1="23" y1="48" x2="19" y2="57"/>
                  <line x1="34" y1="48" x2="30" y2="57"/>
                  <line x1="45" y1="48" x2="41" y2="57"/>
                </svg>

              {% when 71, 73, 75, 77, 85, 86 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 31
                           C14 24 19 20 26 20
                           C28 13 35 10 42 12
                           C49 13 52 18 52 24
                           C58 25 60 29 60 33
                           C60 38 56 41 51 41
                           H23
                           C18 41 14 37 14 31
                           Z"/>
                  <line x1="23" y1="48" x2="23" y2="57"/>
                  <line x1="19" y1="52.5" x2="27" y2="52.5"/>
                  <line x1="34" y1="48" x2="34" y2="57"/>
                  <line x1="30" y1="52.5" x2="38" y2="52.5"/>
                  <line x1="45" y1="48" x2="45" y2="57"/>
                  <line x1="41" y1="52.5" x2="49" y2="52.5"/>
                </svg>

              {% when 95, 96, 99 %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 30
                           C14 23 19 19 26 19
                           C28 12 35 9 42 11
                           C49 12 52 17 52 23
                           C58 24 60 28 60 32
                           C60 37 56 40 51 40
                           H23
                           C18 40 14 36 14 30
                           Z"/>
                  <path d="M34 43 L27 53 H34 L30 61 L43 49 H36 L41 43 Z"/>
                </svg>

              {% else %}
                <svg viewBox="0 0 64 64" class="weather-svg">
                  <path d="M14 40
                           C14 33 19 29 26 29
                           C28 22 35 18 42 20
                           C49 21 53 26 53 32
                           C59 33 61 37 61 42
                           C61 47 57 50 52 50
                           H22
                           C17 50 14 47 14 40
                           Z"/>
                </svg>

            {% endcase %}

          </div>

          <div class="current-description">
            {{ current_description }}
          </div>

        </div>

      </div>

    </div>


    <div class="today-right">

      <div class="high-low">
        High {{ today_high | round }}°
        &nbsp;&nbsp;
        Low {{ today_low | round }}°
      </div>

      <div class="today-details">

        <div>
          <div class="detail-label">Feels like</div>
          <div class="detail-value">
            {{ current.apparent_temperature | round }}°
          </div>
        </div>

        <div>
          <div class="detail-label">Rain chance</div>
          <div class="detail-value">
            {{ today_rain | round }}%
          </div>
        </div>

        <div>
          <div class="detail-label">Humidity</div>
          <div class="detail-value">
            {{ current.relative_humidity_2m | round }}%
          </div>
        </div>

        <div>
          <div class="detail-label">Wind</div>
          <div class="detail-value">
            {{ current.wind_speed_10m | round }} km/h
          </div>
        </div>

      </div>

    </div>

  </div>


  <!-- NEXT FIVE DAYS -->

  <div class="forecast">

    {% for forecast_date in dates offset: 1 limit: 5 %}

      {% assign i = forloop.index %}
      {% assign day_code = codes[i] %}
      {% assign day_high = highs[i] %}
      {% assign day_low = lows[i] %}
      {% assign day_rain = rain_chances[i] %}

      {% case day_code %}
        {% when 0 %}
          {% assign day_description = "Clear" %}
        {% when 1 %}
          {% assign day_description = "Mostly clear" %}
        {% when 2 %}
          {% assign day_description = "Partly cloudy" %}
        {% when 3 %}
          {% assign day_description = "Overcast" %}
        {% when 45, 48 %}
          {% assign day_description = "Fog" %}
        {% when 51, 53, 55 %}
          {% assign day_description = "Drizzle" %}
        {% when 56, 57 %}
          {% assign day_description = "Freezing drizzle" %}
        {% when 61, 63, 65 %}
          {% assign day_description = "Rain" %}
        {% when 66, 67 %}
          {% assign day_description = "Freezing rain" %}
        {% when 71, 73, 75, 77 %}
          {% assign day_description = "Snow" %}
        {% when 80, 81, 82 %}
          {% assign day_description = "Showers" %}
        {% when 85, 86 %}
          {% assign day_description = "Snow showers" %}
        {% when 95, 96, 99 %}
          {% assign day_description = "Thunderstorm" %}
        {% else %}
          {% assign day_description = "Unknown" %}
      {% endcase %}


      <div class="day">

        <div class="day-name">
          {{ forecast_date | l_date: "%a" }}
        </div>

        <div class="day-date">
          {{ forecast_date | l_date: "%b %d" }}
        </div>


        <div class="day-icon">

          {% case day_code %}

            {% when 0, 1 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <circle cx="32" cy="32" r="12"/>
                <line x1="32" y1="5" x2="32" y2="14"/>
                <line x1="32" y1="50" x2="32" y2="59"/>
                <line x1="5" y1="32" x2="14" y2="32"/>
                <line x1="50" y1="32" x2="59" y2="32"/>
                <line x1="13" y1="13" x2="19" y2="19"/>
                <line x1="45" y1="45" x2="51" y2="51"/>
                <line x1="51" y1="13" x2="45" y2="19"/>
                <line x1="19" y1="45" x2="13" y2="51"/>
              </svg>

            {% when 2 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <circle cx="24" cy="22" r="10"/>
                <line x1="24" y1="5" x2="24" y2="10"/>
                <line x1="8" y1="22" x2="13" y2="22"/>
                <line x1="35" y1="11" x2="31" y2="15"/>
                <path d="M18 47
                         C18 40 23 36 29 36
                         C31 29 37 26 43 28
                         C49 29 52 33 52 38
                         C58 39 60 43 60 47
                         C60 52 56 55 51 55
                         H24
                         C20 55 17 52 17 48
                         Z"/>
              </svg>

            {% when 3 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 45
                         C14 38 19 33 26 33
                         C28 25 35 21 42 23
                         C49 24 53 29 53 35
                         C59 36 61 40 61 45
                         C61 50 57 53 52 53
                         H22
                         C17 53 14 50 14 45
                         Z"/>
              </svg>

            {% when 45, 48 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M16 31
                         C16 25 21 21 27 21
                         C30 15 38 14 43 18
                         C48 18 52 22 52 27"/>
                <line x1="10" y1="36" x2="54" y2="36"/>
                <line x1="15" y1="44" x2="49" y2="44"/>
                <line x1="20" y1="52" x2="44" y2="52"/>
              </svg>

            {% when 51, 53, 55, 56, 57 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 34
                         C14 27 19 23 26 23
                         C28 16 35 13 42 15
                         C49 16 52 21 52 27
                         C58 28 60 32 60 36
                         C60 41 56 44 51 44
                         H23
                         C18 44 14 40 14 34
                         Z"/>
                <line x1="24" y1="50" x2="22" y2="55"/>
                <line x1="34" y1="50" x2="32" y2="55"/>
                <line x1="44" y1="50" x2="42" y2="55"/>
              </svg>

            {% when 61, 63, 65, 66, 67, 80, 81, 82 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 32
                         C14 25 19 21 26 21
                         C28 14 35 11 42 13
                         C49 14 52 19 52 25
                         C58 26 60 30 60 34
                         C60 39 56 42 51 42
                         H23
                         C18 42 14 38 14 32
                         Z"/>
                <line x1="23" y1="48" x2="19" y2="57"/>
                <line x1="34" y1="48" x2="30" y2="57"/>
                <line x1="45" y1="48" x2="41" y2="57"/>
              </svg>

            {% when 71, 73, 75, 77, 85, 86 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 31
                         C14 24 19 20 26 20
                         C28 13 35 10 42 12
                         C49 13 52 18 52 24
                         C58 25 60 29 60 33
                         C60 38 56 41 51 41
                         H23
                         C18 41 14 37 14 31
                         Z"/>
                <line x1="23" y1="48" x2="23" y2="57"/>
                <line x1="19" y1="52.5" x2="27" y2="52.5"/>
                <line x1="34" y1="48" x2="34" y2="57"/>
                <line x1="30" y1="52.5" x2="38" y2="52.5"/>
                <line x1="45" y1="48" x2="45" y2="57"/>
                <line x1="41" y1="52.5" x2="49" y2="52.5"/>
              </svg>

            {% when 95, 96, 99 %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 30
                         C14 23 19 19 26 19
                         C28 12 35 9 42 11
                         C49 12 52 17 52 23
                         C58 24 60 28 60 32
                         C60 37 56 40 51 40
                         H23
                         C18 40 14 36 14 30
                         Z"/>
                <path d="M34 43 L27 53 H34 L30 61 L43 49 H36 L41 43 Z"/>
              </svg>

            {% else %}
              <svg viewBox="0 0 64 64" class="weather-svg">
                <path d="M14 40
                         C14 33 19 29 26 29
                         C28 22 35 18 42 20
                         C49 21 53 26 53 32
                         C59 33 61 37 61 42
                         C61 47 57 50 52 50
                         H22
                         C17 50 14 47 14 40
                         Z"/>
              </svg>

          {% endcase %}

        </div>

        <div class="day-description">
          {{ day_description }}
        </div>

        <div class="day-temps">
          {{ day_high | round }}°
          <span class="day-low">
            / {{ day_low | round }}°
          </span>
        </div>

        <div class="day-rain">
          Rain {{ day_rain | round }}%
        </div>

      </div>

    {% endfor %}

  </div>

  <div class="footer">
    Open-Meteo
  </div>

</div>

